//   for(long long int i = 0; i < d; i++) {
//        M = (M * C) % n;
//   }
//   return M;
//}

long long int Exponentiation_Modulaire(long long int C, long long int d, long long int n) {
    long long int M = 1;
    C = C % n;  // Update C if it is more than or equal to n

    while (d > 0) {
        // If d is odd, multiply M with C
        if (d & 1)
            M = (M * C) % n;

        // d must be even now so we can halve it
        d /= 2;
        C = (C * C) % n;
    }
    return M;
}



void chiffrement(LISTECrypt Crypt, LISTE L, Pile pilePublique) {
   int taille = listeTaille(L);
    char ch[Max_Long];
    Crypt->lg = taille;
    for (int i = 1; i <=taille; i++) {
        ELEMENT phrase = recuperer(L,i);
        ELEMENTPile cp = Depiler(pilePublique);
        long long int e = cp->d_or_e;
        long long int n = cp->n;
        int k=0;
        //printf("%llu %llu ", cp->n, cp->d_or_e);
        for (int j = 0; (*phrase)[j] != '\0'; j++) {
            long long int M = Convertir_ASCII((*phrase)[j]);
            long long int C = Exponentiation_Modulaire(M, e, n);
            Crypt->elements[i][j] = C;
            //printf("\nCharacter: %c, ASCII: %llu, Encrypted: %llu", (*phrase)[j], M, C);
            ch[k] = (*phrase)[j];
            k++;
        }
        ch[k] = '\0';
           printf("\n le message originale %i = %s",i,ch);

           printf("\n le Message chiffre %i = ",i);
           for (int j = 0; j < k; j++) {
           printf("%llu ", Crypt->elements[i][j]);
        }
        printf("\n\n");
    }

    PileDetruire(pilePublique);
}

void dechiffrement(LISTECrypt Crypt,Pile pilePrivee){
    char ch[Max_Long];
    int taille = listeTaille1(Crypt);
    for(int i=1;i<=taille;i++){
        ELEMENTPile dp = Depiler(pilePrivee);
        long long int d = dp->d_or_e;
        long long int n = dp->n;
        int h=0;
        //printf("\n%llu %llu ", dp->n, dp->d_or_e);
        for(int j=0;recuperercrypt(Crypt,i,j) != '\0';j++){
            long long int C = recuperercrypt(Crypt,i,j);
            long long int M = Exponentiation_Modulaire(C, d, n);
            //printf("\nEncrypted: %llu, Decrypted: %llu, Character: %c", C, M, Convertir_Char(M));
            ch[h] = Convertir_Char(M);
            h++;
        }
        ch[h] = '\0';
        printf("\nle Message chiffre %i = ",i);
        for (int j = 0; j < h; j++) {
            printf("%llu ", Crypt->elements[i][j]);
        }
        printf("\nle Message dechiffre %i = %s",i,ch);
        printf("\n");
    }
    PileDetruire(pilePrivee);

}

int alea_prem(int Num_Prem[],int taille){
    return Num_Prem[rand() % taille];
}

int est_prem(int num) {
    if (num <= 1) {
        return 0;
    }
    for (int i = 2; i <= num/2; i++) {
        if (num % i == 0) {
            return 0;
        }
    }
    return 1;
}

void generate_prem(int Num_Prem[],int *taille) {
    int num, i = 0;

    for (num = 2; num <= 10000; num++) {
        if (est_prem(num)) {
            Num_Prem[i] = num;
            i++;
        }
    }
    *taille = i;
}

