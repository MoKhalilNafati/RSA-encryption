#define MAX_PR 100
#define Max_Long 100

void entier_au_hasard(int taille_tableau ,int t[],int*p,int*q) {
    int indice_p = rand() % taille_tableau;
    (*p)= t[indice_p];
    int indice_q;
    do
    {
    indice_q = rand() % taille_tableau;
   } while (indice_q == indice_p);
    (*q) = t[indice_q];
}
int nbr_lig()
{
       FILE *fichier = fopen("phrases.txt", "r");

    if (fichier == NULL) {
        perror("Erreur lors de l'ouverture du fichier");
        return 1;
    }

    int nombre_lignes = 0;
    char ligne[1000];

    while (fgets(ligne, sizeof(ligne), fichier) != NULL) {
        nombre_lignes++;
    }
    fclose(fichier);
    return nombre_lignes;
}
void Extraire(char M[MAX_PR][Max_Long],int N) {
    int nb_phr = 0;
    char line[Max_Long];
    FILE* file = fopen("phrases.txt", "r");

    if (file == NULL) {
        printf("Impossible d'ouvrir le fichier\n");

    } else {
        while (fgets(line, sizeof(line), file) != NULL && nb_phr <= N) {
            char* token = strtok(line, "\n");/*strtok--->souschaine jusqu'a  \n*/
            while (token != NULL && nb_phr < N) {
                strcpy(M[nb_phr], token);
                M[nb_phr][Max_Long - 1] = '\0';
                (nb_phr)++;
                token = strtok(NULL, "\n");
            }
        }
    }
    fclose(file);
}

void ListeRemplir(char M[][Max_Long], int N, LISTE L) {
    for (int i = 0; i < N; i++) {
        inserer(L, M[i], i + 1);
    }
}

void messages_ajouter(){
FILE *file;
    char sentence[100];
    int nb_saisir;

    file = fopen("phrases.txt", "a");

    if (file == NULL) {
        printf("Uncapable d'ouvrir le fichier.\n");
        return 1;
    }
    else{
         printf("\ndonner le nombre de message a saisir : ");
        scanf("%i",&nb_saisir);
    for (int i = 0; i < nb_saisir; i++) {
        fflush(stdin);
        printf("\nEntrer le message %d: ", i + 1);
        gets(sentence);
        fprintf(file, "%s\n", sentence);
    }

    }
    printf("\nMessage(s) Enregitree avec success.\n");

    fclose(file);

    }

int mod_inverse(int a, int m) {
    int m0 = m, t, q;
    int x0 = 0, x1 = 1;

    if (m == 1)
        return 0;

    while (a > 1) {
        q = a / m;
        t = m;
        m = a % m, a = t;
        t = x0;
        x0 = x1 - q * x0;
        x1 = t;
    }

    if (x1 < 0)
        x1 += m0;

    return x1;
}

int random_int(int min, int max) {
    return min + rand() % (max - min + 1);
}

bool pgcd(int a, int b) {
    while (b != 0) {
        int temp = b;
        b = a % b;
        a = temp;
    }
    return a == 1;
}

int exposant(int phi_n) {
    int e;
    do {
        e = random_int(2, phi_n - 1);
    } while (!pgcd(e, phi_n));
    return e;
}

void PilesRemplir(Pile pilepublic, Pile pileprivee,int Num_Prem[], int taille, int N, int *p, int *q, long long int *n, long long int *Euler, long long int *e, long long int *d) {
    for (int i = 0; i < N; i++) {
//        *p = alea_prem(Num_Prem, taille);
//        *q = alea_prem(Num_Prem, taille);
         entier_au_hasard(taille ,Num_Prem,p,q);
         //printf("\np=%i  q=%i",*p,*q);
        *n = (*p) * (*q);
        *Euler = (*p - 1) * (*q - 1);
        //printf("p=%i q=%i n=%llu Euler=%llu", *p, *q, *n, *Euler);
        *e = exposant(*Euler);
        //printf("   e=%llu", *e);
        *d = mod_inverse(*e, *Euler);
        //printf("   d=%llu", *d);
        ELEMENTPile e1 = elementPileCreer(*n, *e);
        ELEMENTPile e2 = elementPileCreer(*n, *d);
        Empiler(pilepublic, e1);
        Empiler(pileprivee, e2);
    }
}

